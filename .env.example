# Copy to .env and adjust. Every setting is optional.
AIOREDGIF_DOWNLOAD_DIR=downloads
AIOREDGIF_UPSTREAM_CONCURRENCY=4
AIOREDGIF_UPSTREAM_MIN_INTERVAL=0.35
AIOREDGIF_DOWNLOAD_CONCURRENCY=3
AIOREDGIF_AUTO_RESUME=true
AIOREDGIF_LIBRARY_RESCAN_SECONDS=30
AIOREDGIF_FREE_RPM=30
AIOREDGIF_FREE_MAX_ITEMS_PER_JOB=100
# Comma separated keys that skip the free-tier limits (send as X-API-Key)
AIOREDGIF_API_KEYS=
AIOREDGIF_BROWSER_ENABLED=true
